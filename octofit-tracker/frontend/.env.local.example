# OctoFit Tracker Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# GitHub Codespaces Name
# Required for Codespaces deployment
# Leave empty or omit for localhost development
# Example: VITE_CODESPACE_NAME=my-codespace-12345
VITE_CODESPACE_NAME=

# Development API Port (used only with localhost)
# Default: 8000
# VITE_API_PORT=8000
